{
  "name": "fileyard",
  "private": true,
  "description": "Fileyard, a file manager built with React, Vite, Hono, and Cloudflare Workers",
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build",
    "cf-typegen": "wrangler types",
    "check": "npm run cf-typegen && tsc && vite build && wrangler deploy --dry-run -c wrangler.jsonc",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply fileyard-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply fileyard-db --remote",
    "deploy": "npm run build && wrangler deploy -c wrangler.jsonc",
    "dev": "npm run db:migrate:local && vite",
    "postinstall": "node scripts/patch-oxc-parser.mjs",
    "knip": "knip",
    "lint": "npm run cf-typegen && oxlint . --fix && oxfmt .",
    "preview": "npm run build && vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "better-auth": "^1.6.2",
    "client-zip": "^2.5.0",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "github-markdown-css": "^5.9.0",
    "hono": "4.12.23",
    "marked": "^18.0.9",
    "p-queue": "^9.3.0",
    "react": "19.2.1",
    "react-atomic-store": "^0.0.9",
    "react-dom": "19.2.1",
    "react-hot-toast": "^2.6.0",
    "react-qr-code": "^2.0.18",
    "react-router-dom": "^7.13.2",
    "swr": "^2.4.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.2.2"
  },
  "devDependencies": {
    "@babel/types": "^7.29.0",
    "@better-auth/cli": "^1.4.21",
    "@cloudflare/vite-plugin": "^1.42.4",
    "@cloudflare/vitest-pool-workers": "^0.17.0",
    "@iconify/json": "^2.2.463",
    "@rolldown/plugin-babel": "^0.2.2",
    "@svgr/core": "^8.1.0",
    "@svgr/plugin-jsx": "^8.1.0",
    "@types/node": "^24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "daisyui": "^5.5.19",
    "drizzle-kit": "^0.31.10",
    "knip": "^6.4.1",
    "oxc-parser": "^0.126.0",
    "oxfmt": "^0.42.0",
    "oxlint": "^1.57.0",
    "typescript": "^6.0.3",
    "unplugin-icons": "^23.0.1",
    "vite": "^8.1.3",
    "vite-bundle-analyzer": "^1.3.8",
    "vitest": "^4.1.2",
    "wrangler": "^4.106.0"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    },
    "kysely": "0.28.17",
    "postcss": "8.5.15"
  },
  "cloudflare": {
    "label": "Fileyard",
    "products": [
      "Workers"
    ],
    "categories": [],
    "preview_icon_url": "https://imagedelivery.net/wSMYJvS3Xw-n339CbDyDIA/532a5378-9717-4964-385b-5fafd2160200/public",
    "preview_image_url": "https://imagedelivery.net/wSMYJvS3Xw-n339CbDyDIA/ec7f4be5-d1d6-4e94-0851-126341745400/preview",
    "publish": true
  }
}
